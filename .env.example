# Copy this to .env and fill in values (never commit .env to GitHub)
TELEGRAM_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Paper account settings
ACCOUNT_SIZE=1000

# Per-bot risk (from backtest optimization)
ORB_RISK_PCT=0.005     # 0.5% — ORB MaxDD blows at 1%, safe at 0.5%
CISD_RISK_PCT=0.010    # 1.0% — CISD MaxDD 17.6% at 1%, fine
SCHOOL_RISK_PCT=0.020  # 2.0% — School Run optimal (CAGR 24%, DD 16.5%)
